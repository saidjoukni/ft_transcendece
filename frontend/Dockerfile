FROM node:22-alpine

WORKDIR /app

# package.json pins the pnpm version used by the project.
RUN corepack enable

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
RUN pnpm install --frozen-lockfile

COPY . .
ARG NEXT_PUBLIC_GOOGLE_CLIENT_ID

RUN pnpm build

EXPOSE 3000

CMD ["pnpm", "start"]
